# Copy this file to server/.env and fill in your values

# Supabase project URL (same as VITE_SUPABASE_URL in root .env)
SUPABASE_URL=https://dlxorynfbjdrcyavriuc.supabase.co

# Supabase SERVICE ROLE key — from Supabase Dashboard > Project Settings > API
# WARNING: Never commit this to git. Add server/.env to .gitignore.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret for verifying user tokens — from Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Port for the Express server (Vite proxy expects 3001)
PORT=3001
